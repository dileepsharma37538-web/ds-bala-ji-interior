rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public website media: anyone can view, only signed-in managers can change it.
    match /services/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
  }
}
